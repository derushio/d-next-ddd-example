DB_USER="postgres"
DB_PASSWORD="password"
DB_NAME="app"
DB_HOST="127.0.0.1"
DB_PORT="5465"

DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public&sslmode=disable"

# portless管理: main用デフォルト値。worktreeではworktree-setupが自動書き換え
NEXT_PUBLIC_BASE_URL="http://d-next-ddd-example.localhost:1355"
TOKEN_SECRET=""
TOKEN_MAX_AGE_MINUTES="60"
TOKEN_UPDATE_AGE_MINUTES="2.5"

NEXT_PUBLIC_APP_NAME="D-Next Resources"

# portless管理: main用デフォルト値。worktreeではworktree-setupが自動書き換え
AUTH_URL="http://d-next-ddd-example.localhost:1355"
AUTH_SECRET=""

# ロギング
# LOG_LEVEL="info"        # debug | info | warn | error
# LOG_MASK_PII="true"     # PIIマスク有効化（デフォルト: true）

# セッション・JWT有効期限
# SESSION_MAX_AGE_SECONDS="2592000"  # デフォルト: 30日（秒換算）
# JWT_MAX_AGE_SECONDS="2592000"      # デフォルト: 30日（秒換算）

# Rate Limiting（認証）
# AUTH_RATE_LIMIT_ENABLED="true"        # デフォルト: true
# AUTH_RATE_LIMIT_MAX="5"               # デフォルト: 5回（範囲: 1〜1000）
# AUTH_RATE_LIMIT_WINDOW_MS="60000"     # デフォルト: 1分（範囲: 1秒〜1時間）

# アカウントロックアウト
# AUTH_LOCKOUT_ENABLED="true"           # デフォルト: true
# AUTH_LOCKOUT_THRESHOLD="5"            # デフォルト: 5回失敗（範囲: 1〜100）
# AUTH_LOCKOUT_DURATION_MS="900000"     # デフォルト: 15分（範囲: 1分〜24時間）

# パスワードポリシー
# PASSWORD_MIN_LENGTH="8"               # デフォルト: 8文字（範囲: 1〜1000）
# PASSWORD_MAX_LENGTH="128"             # デフォルト: 128文字（範囲: 1〜1000）
# PASSWORD_CHECK_USER_INFO="true"       # デフォルト: true（パスワードにユーザー情報を含めない）
