{
  "name": "d-next-ddd-example",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@node-rs/argon2": "^2.0.2",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@prisma/client-runtime-utils": "^7.9.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "es-toolkit": "^1.49.0",
    "lucide-react": "^1.25.0",
    "neverthrow": "^8.2.0",
    "next": "16.3.0-preview.8",
    "next-auth": "5.0.0-beta.32",
    "pino": "^10.3.1",
    "radix-ui": "^1.6.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.82.0",
    "reflect-metadata": "^0.2.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tsyringe": "^4.10.0",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@dotenvx/dotenvx": "^2.17.1",
    "@faker-js/faker": "^10.5.0",
    "@onozaty/prisma-db-comments-generator": "^1.8.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "fishery": "^2.4.0",
    "hygen": "^6.2.11",
    "jsdom": "^29.1.1",
    "markdownlint-cli": "^0.49.1",
    "npm-run-all2": "^9.0.2",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "vitest-mock-extended": "^5.1.0"
  },
  "scripts": {
    "dev": "pnpm run-p next:dev db:generate:watch db:studio",
    "build": "pnpm run-s db:generate next:build",
    "start": "pnpm next:start",
    "check": "pnpm run-s format type-check lint test:unit",
    "check:argon2-tracing": "pnpm run-s build && node scripts/checkArgon2Tracing.mjs",
    "lint": "biome lint src tests",
    "lint:fix": "biome lint --write src tests",
    "format": "pnpm run-p format:biome format:markdown",
    "format:biome": "biome format --write src tests package.json biome.json",
    "format:check": "biome format src tests package.json biome.json",
    "format:markdown": "pnpm markdownlint --fix '**/*.md'",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next out dist coverage",
    "test": "pnpm run-s test:unit test:e2e",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "cross-env CI=true playwright test --workers=4",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:trace": "playwright test --trace on",
    "test:e2e:headed": "playwright test --headed",
    "next:dev": "portless $(node scripts/resolveProjectBase.mjs --portless-name) next dev --turbopack",
    "next:build": "next build",
    "next:build:turbo": "next build --turbopack",
    "next:start": "next start",
    "db:generate": "pnpm prisma generate --sql",
    "db:generate:watch": "pnpm prisma generate --sql --watch",
    "db:format": "pnpm prisma format",
    "db:push": "pnpm prisma db push",
    "db:migrate:dev": "pnpm prisma migrate dev",
    "db:migrate:deploy": "pnpm prisma migrate deploy",
    "db:seed": "pnpm prisma db seed",
    "db:studio": "pnpm prisma studio --browser none --port 0",
    "dev:measure": "node scripts/measureDevCpu.mjs",
    "hash:generate": "pnpm dotenvx run -- pnpm tsx ./src/tools/generateHash.ts",
    "ui:add": "npx shadcn@latest add",
    "ui:update": "npx shadcn@latest diff",
    "ui:list": "npx shadcn@latest list",
    "gen": "hygen",
    "gen:usecase": "hygen usecase new",
    "gen:entity": "hygen entity new",
    "gen:vo": "hygen value-object new",
    "gen:repo": "hygen repository new",
    "gen:action": "hygen server-action new",
    "postinstall": "prisma generate && next typegen"
  },
  "prisma": {
    "seed": "pnpm tsx ./src/layers/infrastructure/persistence/prisma/seeds/index.ts"
  }
}
